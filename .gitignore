# Python and tool caches
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
build/
/dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
.coverage

# Keys, certificates, secrets and customer data made while trying the suite
/pki/
*.pem
*.key
!tests/**/*.pem
.env
.env.*
*.part
readiness-out/

# the Readiness quality corpus holds deliberate test keys and weak code
!products/readiness/bench/corpus/**

# browser tests
node_modules/
test-results/
playwright-report/

# operating systems
.DS_Store
Thumbs.db

.impeccable/

# product films: renders, raw recordings and audio live in C:\Users\<you>\AcxelinVideos, not here
video/out/
video/raw/
video/audio/
*.mp4
*.mov
*.webm
*.wav
*.m4a
!website/assets/films/*.mp4
